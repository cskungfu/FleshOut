{
  "name": "w1-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.fleshout.app",
    "productName": "FleshOut",
    "asar": false,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/.cache/**",
      "!*.log",
      "!FleshOut-data/**"
    ],
    "win": {
      "target": [
        { "target": "7z", "arch": ["x64"] }
      ]
    }
  }
}
